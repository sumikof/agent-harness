# Copy to .env and edit. All serving knobs live here — compose.yaml and
# start.sh only interpolate.

# ---------------------------------------------------------------------------
# Container image — PIN AN EXPLICITLY TESTED TAG. Never ship `latest`.
# Prefer the NGC vLLM container built for DGX Spark (ARM64 + Blackwell).
# After the first successful start, record the exact tag you verified here
# (setup_dgx_spark.sh checks the container's `vllm --version` >= 0.19; use a
# newer container if the check fails).
# ---------------------------------------------------------------------------
# Example (replace with the tag YOU verified on your DGX Spark):
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.09-py3
# Minimum vLLM version required inside the container (Qwen3.6 support).
VLLM_MIN_VERSION=0.19

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
MODEL=Qwen/Qwen3.6-27B-FP8
SERVED_MODEL_NAME=qwen3.6-27b-fp8
# Optional: pin a HF revision for reproducibility (empty = default branch).
MODEL_REVISION=
HF_TOKEN=

# Host directory persisted into the container — model downloads survive
# container re-creation (never re-download 30GB per restart).
HF_CACHE_DIR=~/.cache/huggingface

# ---------------------------------------------------------------------------
# Serving profile (KNOWN-GOOD BASELINE — final values come from
# benchmark.sh / scripts/benchmark_inference.py, then get frozen in
# config/inference-tuning.json)
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
TENSOR_PARALLEL_SIZE=1

# Context profile: performance=65536 (production default) | long=131072 |
# maximum=262144. Longer profiles trade KV-cache capacity (=parallel
# agents) for context; select per deployment, not per whim.
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=32768
# DGX Spark also runs the harness, builds, tests, SQLite and the OS —
# do NOT blindly raise this. Baseline 0.80; sweep 0.75-0.90 in benchmarks.
GPU_MEMORY_UTILIZATION=0.80
# Weight quantization (FP8 checkpoint) is separate from KV-cache dtype.
# auto = baseline; fp8 KV only as an explicit benchmarked profile.
KV_CACHE_DTYPE=auto

# Qwen3.6 parsers (text-only serving: the harness is a coding workload,
# vision memory goes to KV cache / batching instead)
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder

# Speculative decoding — abstracted so a compatible DSpark speculator can
# replace MTP later WITHOUT code changes. Current production baseline: the
# model's own MTP head. num_speculative_tokens is a benchmark subject
# (sweep OFF/1/2/3/4), not a constant. Set SPECULATIVE_CONFIG= (empty) to
# disable speculative decoding entirely.
#   MTP     : {"method":"qwen3_next_mtp","num_speculative_tokens":2}
#   DSpark  : {"method":"dspark","model":"/models/qwen3.6-27b-dspark","num_speculative_tokens":7}
#             (ONLY with a speculator whose Qwen3.6-27B compatibility is confirmed)
SPECULATIVE_CONFIG={"method":"qwen3_next_mtp","num_speculative_tokens":2}

# Extra flags appended verbatim to `vllm serve` (version-specific options,
# e.g. a prefix-match-unit knob if your vLLM version supports one).
EXTRA_ARGS=
